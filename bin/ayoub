#!/usr/bin/env bash
set -Eeuo pipefail
CYAN='\033[38;5;117m'
RESET='\033[0m'
case "${1:-}" in
  -h|--help)
    printf 'AYOUB OS commands\n  ayoub       Show system dashboard\n  ayoub -h    Show help\n'
    exit 0
    ;;
  "")
    printf '%b' "$CYAN"
    cat <<'LOGO'
       .--.
      |o_o |
      |:_/ |
     //   \\
    (|     | )
   /'\\_   _/`\\
   \\___)=(___/
LOGO
    printf '%b\n' "$RESET"
    if command -v fastfetch >/dev/null 2>&1; then
      fastfetch
    else
      printf 'Host: %s\n' "$(hostname 2>/dev/null || printf 'unknown')"
      printf 'Kernel: %s\n' "$(uname -sr 2>/dev/null || printf 'unknown')"
      printf 'Install Fastfetch for the full system dashboard.\n'
    fi
    ;;
  *)
    printf 'Unknown option: %s\n' "$1" >&2
    exit 2
    ;;
esac
