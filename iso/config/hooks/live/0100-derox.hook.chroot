#!/bin/sh
set -e

install -d -m 0755 /usr/local/share/derox-os
install -d -m 0755 /etc/skel/.config/autostart

cat > /usr/local/share/derox-os/README.txt <<'EOF'
DEROX OS
An independent Debian 12 live system with XFCE4.
Terminal command: derox
This is a community project, not an official Debian release.
EOF

cat > /usr/local/bin/derox <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
CYAN='\033[38;5;117m'
BLUE='\033[38;5;75m'
RESET='\033[0m'
case "${1:-}" in
  -h|--help)
    printf 'DEROX OS commands\n  derox       Show system dashboard\n  derox -h    Show help\n'
    exit 0
    ;;
  "")
    version="unknown"
    [[ -r /etc/derox-version ]] && version="$(cat /etc/derox-version)"
    printf '%b' "$CYAN"
    cat <<'LOGO'
       ____  _____ ____   ____  __
      |  _ \\| ____|  _ \\ / ___|/ /
      | | | |  _| | |_) | |   / /
      | |_| | |___|  _ <| |__/_/
      |____/|_____|_| \\_\\____(_)
LOGO
    printf '%b\n' "$RESET"
    version='unknown'
    [[ -r /etc/derox-version ]] && version="$(cat /etc/derox-version)"
    os_name='Linux'
    if [[ -r /etc/os-release ]]; then
      . /etc/os-release
      os_name="DEROX OS v${version} (Debian 12 Bookworm)"
    fi
    cpu_name="$(awk -F: '/model name/ {sub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo 2>/dev/null || true)"
    [[ -n "$cpu_name" ]] || cpu_name='Unknown'
    mem_total="$(awk '/MemTotal:/ {printf "%.1f GiB", $2/1024/1024}' /proc/meminfo 2>/dev/null || true)"
    mem_available="$(awk '/MemAvailable:/ {printf "%.1f GiB", $2/1024/1024}' /proc/meminfo 2>/dev/null || true)"
    [[ -n "$mem_total" ]] || mem_total='Unknown'
    [[ -n "$mem_available" ]] || mem_available='Unknown'
    disk_info="$(df -h "$HOME" 2>/dev/null | awk 'NR==2 {printf "%s used / %s total (%s)", $3, $2, $5}')"
    [[ -n "$disk_info" ]] || disk_info='Unknown'
    printf '%b%-12s%b %s\n' "$BLUE" 'OS' "$RESET" "$os_name"
    printf '%b%-12s%b %s\n' "$BLUE" 'Host' "$RESET" "$(hostname 2>/dev/null || printf 'Unknown')"
    printf '%b%-12s%b %s\n' "$BLUE" 'Kernel' "$RESET" "$(uname -sr 2>/dev/null || printf 'Unknown')"
    printf '%b%-12s%b %s\n' "$BLUE" 'Architecture' "$RESET" "$(uname -m 2>/dev/null || printf 'Unknown')"
    printf '%b%-12s%b %s total, %s available\n' "$BLUE" 'Memory' "$RESET" "$mem_total" "$mem_available"
    printf '%b%-12s%b %s\n' "$BLUE" 'Disk' "$RESET" "$disk_info"
    printf '\nWelcome to DEROX OS v%s!\n' "$version"
    ;;
  *)
    printf 'Unknown option: %s\n' "$1" >&2
    exit 2
    ;;
esac
EOF
chmod 0755 /usr/local/bin/derox

# Show a small, non-intrusive welcome message in new interactive Bash shells.
if ! grep -q 'DEROX OS welcome' /etc/skel/.bashrc; then
  cat >> /etc/skel/.bashrc <<'EOF'

# DEROX OS welcome
if [[ $- == *i* ]] && [[ -z "${DEROX_WELCOME_SHOWN:-}" ]]; then
  export DEROX_WELCOME_SHOWN=1
  printf '\033[38;5;117mWelcome to DEROX OS! Type derox for system information.\033[0m\n'
fi
EOF
fi

# Apply the DEROX dark neon wallpaper and a clean desktop with one installer icon.
install -d -m 0755 /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/derox-wallpaper.svg"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
    </property>
  </property>
  <property name="desktop-icons" type="empty">
    <property name="style" type="int" value="2"/>
    <property name="icon-size" type="int" value="48"/>
    <property name="file-icons" type="empty">
      <property name="show-home" type="bool" value="false"/>
      <property name="show-filesystem" type="bool" value="false"/>
      <property name="show-trash" type="bool" value="false"/>
      <property name="show-removable" type="bool" value="false"/>
    </property>
  </property>
</channel>
EOF

# Give the installer DEROX branding in the application menu and live desktop.
install -d -m 0755 /usr/share/applications /etc/skel/Desktop
cat > /usr/share/applications/debian-installer-launcher.desktop <<'EOF'
[Desktop Entry]
Version=1.0
Name=Install DEROX OS
Comment=Install DEROX OS permanently to your computer
Exec=su-to-root -X -c /usr/sbin/debian-installer-launcher
TryExec=/usr/sbin/debian-installer-launcher
Icon=debian-installer-launcher
Type=Application
Categories=System;
StartupNotify=true
Terminal=false
EOF
install -m 0755 /usr/share/applications/debian-installer-launcher.desktop "/etc/skel/Desktop/Install DEROX OS.desktop"

# Enable networking and Bluetooth automatically in the live session.
if command -v systemctl >/dev/null 2>&1; then
  systemctl enable NetworkManager.service
  systemctl enable bluetooth.service
fi
