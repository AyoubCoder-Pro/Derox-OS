{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derox-os.example/schemas/source-lock-v1.json",
  "title": "DEROX upstream source lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "distribution", "release_track", "architecture", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "distribution": { "const": "DEROX OS" },
    "release_track": { "type": "string", "minLength": 1 },
    "architecture": { "const": "x86_64" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "url", "archive", "sha256", "license", "homepage"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9+._-]{0,63}$" },
          "version": { "type": "string", "minLength": 1, "maxLength": 128 },
          "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
          "archive": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+$" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "license": { "type": "string", "minLength": 1, "maxLength": 128 },
          "homepage": { "type": "string", "pattern": "^https://[^\\s]+$" }
        }
      }
    }
  }
}
